{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "dbconn": "your_Db_Connection_String"

  },
  "GeckoAPI": {
    "BaseURL": "your_Api_Base_URL",
    "Apikey": "your_Api_key"
  },
  "jwt": {
    "Key": "your_secret_key",
    "Issuer": "JwtIssuer",
    "Audience": "JwtAudience",
    "ExpireMinutes": 60
  },
  "AllowedHosts": "*"
}